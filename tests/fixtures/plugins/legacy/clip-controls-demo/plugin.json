{
  "id": "clipcraft-examples.clip-controls-demo",
  "name": "Clip controls demo",
  "publisher": "ClipCraft examples",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "A native toolbar/inspector/menu action that changes one selected, unlinked picture clip's opacity after host review, as one Undo step.",
  "entry": "commands.js",
  "permissions": ["editor.read", "clips.properties"],
  "contributes": {
    "commands": [{"id":"opacity","name":"Set picture opacity","parameters":[{"id":"opacity","name":"Opacity","min":0.2,"max":1,"step":0.05,"default":0.7}]}],
    "actions": [{"id":"opacity","commandId":"opacity","label":"Picture opacity demo","icon":"layers","locations":["plugins-menu","clip-menu","toolbar","inspector"],"when":{"selection":"single","lanes":["video","overlay"]}}]
  }
}
