{
  "id": "clipcraft-examples.media-library-jobs",
  "name": "Local media library jobs",
  "publisher": "ClipCraft examples",
  "version": "1.0.0",
  "apiVersion": 1,
  "minClipcraftVersion": "2.0.0",
  "entry": "commands.js",
  "description": "Import a picked image or process a picked source with a fixed recipe. Add one verified item to the library; originals and timeline clips are preserved.",
  "permissions": [
    "media.import",
    "media.process"
  ],
  "contributes": {
    "commands": [
      {
        "id": "prepare-media",
        "name": "Prepare picked media",
        "parameters": [
          {
            "id": "operation",
            "name": "Operation",
            "type": "enum",
            "default": "import-image",
            "options": [
              {
                "value": "import-image",
                "label": "Import image"
              },
              {
                "value": "resize-image",
                "label": "Resize image"
              },
              {
                "value": "extract-audio",
                "label": "Extract audio"
              },
              {
                "value": "trim-video",
                "label": "Trim video"
              }
            ]
          },
          {
            "id": "size",
            "name": "Longest image edge",
            "type": "enum",
            "default": "size-640",
            "options": [
              {
                "value": "size-320",
                "label": "320 px"
              },
              {
                "value": "size-640",
                "label": "640 px"
              },
              {
                "value": "size-1280",
                "label": "1280 px"
              }
            ]
          },
          {
            "id": "start_sec",
            "name": "Source start (seconds)",
            "min": 0,
            "max": 1000000,
            "step": 0.1,
            "default": 0
          },
          {
            "id": "duration_sec",
            "name": "Source duration (seconds)",
            "min": 0.1,
            "max": 60,
            "step": 0.1,
            "default": 1
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "prepare-media",
        "commandId": "prepare-media",
        "label": "Prepare picked media",
        "icon": "layers",
        "locations": [
          "plugins-menu",
          "toolbar",
          "inspector"
        ],
        "when": {
          "selection": "none"
        }
      }
    ]
  }
}
