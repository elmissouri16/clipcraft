{
  "id": "clipcraft-examples.project-dashboard",
  "name": "Project dashboard",
  "publisher": "ClipCraft examples",
  "version": "1.2.0",
  "apiVersion": 1,
  "description": "Live project statistics, approved chapter markers and saved note/preferences scoped to this plugin version.",
  "permissions": [
    "project.read",
    "markers.write"
  ],
  "contributes": {
    "panels": [
      {
        "id": "dashboard",
        "name": "Project dashboard",
        "entry": "panel.html",
        "script": "panel.js",
        "style": "panel.css",
        "permissions": [
          "project.read",
          "storage.local"
        ],
        "commands": [
          "add-chapter-markers"
        ]
      }
    ],
    "commands": [
      {
        "id": "add-chapter-markers",
        "name": "Add chapter markers",
        "description": "Add markers from the beginning of the timeline. Existing marker positions are preserved.",
        "parameters": [
          {
            "id": "count",
            "name": "Chapter count",
            "min": 1,
            "max": 20,
            "step": 1,
            "default": 5,
            "integer": true
          }
        ]
      }
    ]
  },
  "entry": "commands.js"
}
